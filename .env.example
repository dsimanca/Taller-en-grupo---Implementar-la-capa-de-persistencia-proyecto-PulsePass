# PulsePass - plantilla de variables de entorno (Fase 4: seguridad)
# Copiar a .env y completar localmente. NUNCA subir un secreto real al repositorio.

# Clave HMAC para firmar/verificar JWT (HS256). Base64 de al menos 32 bytes aleatorios.
# Generar con: openssl rand -base64 32
PULSEPASS_JWT_SECRET_BASE64=

# Emisor esperado del JWT (claim iss).
PULSEPASS_JWT_ISSUER=pulsepass-api

# Origenes CORS permitidos (separados por coma).
PULSEPASS_CORS_ALLOWED_ORIGINS=http://localhost:4200
